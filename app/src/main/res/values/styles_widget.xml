<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="WidgetTaskRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:paddingTop">2.5dp</item>
        <item name="android:paddingBottom">2.5dp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/widget_ink</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="WidgetTaskRowSmall">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/widget_ink</item>
        <item name="android:textSize">11.5sp</item>
    </style>

    <style name="WidgetTaskRowLarge">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/widget_ink</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
